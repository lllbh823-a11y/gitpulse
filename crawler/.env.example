# GitHub Personal Access Token (recommended to avoid 60 req/hr unauthenticated rate limit)
GITHUB_TOKEN=

# OpenAI-compatible Chat Completions API settings (中国大陆公开上线推荐优先使用国内已备案模型，如 DeepSeek / 通义千问 / 智谱)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# WeChat CloudBase ingestIssue HTTP trigger URL & shared HMAC secret
CLOUDBASE_INGEST_URL=
INGEST_SECRET=

# Optional compliance tuning (comma-separated)
# COMPLIANCE_EXTRA_BLOCKLIST=custom-keyword-1,custom-keyword-2
# COMPLIANCE_ALLOWLIST=owner/legitimate-repo#circumvention-clash-vpn-meta

# Optional runtime tuning
# LLM_CONCURRENCY=3
# GITHUB_CONCURRENCY=4
# DAILY_LIMIT=20
# WEEKLY_LIMIT=10
# HTTP_TIMEOUT_MS=20000
