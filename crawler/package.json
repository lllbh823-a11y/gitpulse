{
  "name": "gitpulse-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Trending scraper, metadata enricher, AI Chinese summarizer, and CloudBase ingest pipeline for GitPulse",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "sync": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "generate-feeds": "tsx src/generateFeeds.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
