{
  "name": "gitpulse-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "GitPulse（开源每日脉搏）微信小程序与 H5 前端",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
