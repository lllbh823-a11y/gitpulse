    "dev:h5": "taro build --type h5 --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/router": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "@tarojs/taro-h5": "4.3.3",
    "@babel/runtime": "^7.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.4",
    "@babel/preset-typescript": "^7.24.4",
    "@tarojs/cli": "4.3.3",
    "@tarojs/vite-runner": "4.3.3",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-preset-taro": "4.3.3",
    "react-refresh": "^0.14.2",
    "sass": "^1.79.4",
    "typescript": "^5.6.3",
    "vite": "^4.5.5"
